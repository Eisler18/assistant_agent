# IANA timezone name used as the user's local reference point for
# relative date expressions like "today", "tomorrow", "next Monday".
# Defaults to UTC if not set.
# Examples: Europe/Madrid, America/New_York, Asia/Tokyo
AGENT_TIMEZONE=Europe/Madrid

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=assistant_agent

# LLM — placeholder
LLM_MODEL_NAME=gemini-2.5-flash-lite
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-server/v1

# Agent graph selection: 'react' to use the ReAct agent, unset or other value
# to use the default workflow graph.
AGENT_GRAPH=

# Postgres connection(s) used to persist graph checkpoints (conversation
# state, including pending interrupts) across restarts. ENVIRONMENT picks which 
# URL below Config actually uses — production -> DATABASE_URL, development -> DEV_DATABASE_URL,
# test -> TEST_DATABASE_URL. Leaving the selected one unset falls back to an
# in-memory checkpointer (state is lost on restart) — useful for quick local
# runs without Docker.
POSTGRES_PASSWORD=your-postgres-password
ENVIRONMENT=development
DATABASE_URL=postgresql://assistant_agent:${POSTGRES_PASSWORD}@postgres:5432/assistant_agent
DEV_DATABASE_URL=postgresql://assistant_agent:${POSTGRES_PASSWORD}@localhost:5432/assistant_agent
TEST_DATABASE_URL=postgresql://assistant_agent:${POSTGRES_PASSWORD}@localhost:5432/assistant_agent_test
